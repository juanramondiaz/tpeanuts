# Environment of the benchmark jobs on the cluster. Copy to env.sh (ignored by git) and edit the paths.
# Sourced by run.sh; it must define BENCH_REPO and one bench_activate_<backend> function per backend.

# The checkout of this repository on the shared filesystem (the one the jobs can see), with its MANIFEST.json
# (python -m benchmarks.nusquids.sync_wsl --manifest-only, made before the upload or after the clone).
export BENCH_REPO="$HOME/tpeanuts"

# The original PEANUTS (a separate repository) and the nuSQuIDS astro data (python -m validation.nusquids.fetch_data).
export PEANUTS_PATH="$HOME/PEANUTS"
export NUSQUIDS_DATA_DIR="$HOME/nusquids_data"

# One environment per backend; use whatever the cluster provides (conda, modules, a venv).
bench_activate_tpeanuts() {   # torch with CUDA, and the repository installed: pip install -e .
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
    conda activate tpeanuts
}
bench_activate_peanuts() {    # numpy, numba, scipy, pandas, mpmath; no torch
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
    conda activate peanuts
}
bench_activate_nusquids() {   # the nuSQuIDS wheel
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
    conda activate nusquids
}
