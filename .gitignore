# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Notebook and editor caches
.ipynb_checkpoints/
*.ipynb_checkpoints/
.spyproject/

# Local/generated artifacts
.cache_exposure/
cache_exposure/
exposure_cache/
outputs/
Outputs/

# Any directory starting with underscore (_avast_, _cache_, etc.)
_*/

# Build artifacts
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# OS/editor noise
.DS_Store
Thumbs.db

# IDE and local config files
.vscode/
.agents/
pyrightconfig.json
*.code-workspace

# Local scratch files
head.py
/run_*.py

# Thesis LaTeX source (build PDFs are published separately, not the source tree)
documentation.thesis/

# Companion documentation: keep only the compiled PDFs, not the LaTeX sources
documentation/*
!documentation/*.pdf
